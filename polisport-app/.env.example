# ============================================================
#  POLISPORT TOURNAMENT — Environment Variables Reference
# ============================================================

# 1. Baza de date SQLite locală (Implicit: data/polisport.db)
# Pe Vercel, dacă nu e specificat, sistemul folosește /tmp/polisport.db clonat automat din data/polisport.db
DATABASE_PATH=data/polisport.db

# 2. URL-ul public al aplicației (pe Vercel se setează la domeniul asignat, ex: https://polisport.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. Autentificare Administrator
ADMIN_EMAIL=andrei.armean17@gmail.com
ADMIN_PASSWORD=admin123
